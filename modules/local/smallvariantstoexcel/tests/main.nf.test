nextflow_process {

    name "Test Process SMALLVARIANTS_TO_EXCEL"
    script "../main.nf"
    process "SMALLVARIANTS_TO_EXCEL"

    tag "modules"
    tag "smallvariantstoexcel"

    test("ToExcel output reporting [meta, samplesheet, api_data, input_files, min_coverage, reference_genome, variant_caller, runtype]") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'test_run' ],
                    file("${moduleTestDir}/samplesheet.csv", checkIfExists: true)
                ]
                input[1] = file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/smallvariantstoexcel/api_data.json", checkIfExists: true)
                input[2] = [
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/smallvariantstoexcel/Panel_v1.bed", checkIfExists: true),
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/smallvariantstoexcel/Design_v1.bed", checkIfExists: true),
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/smallvariantstoexcel/Panel_v1", checkIfExists: true),
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/smallvariantstoexcel/Design_v1", checkIfExists: true),
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/smallvariantstoexcel/Design_v1_all_genes_vs_transcripts", checkIfExists: true),
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/smallvariantstoexcel/sample1.vardict.vcf.gz", checkIfExists: true),
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/smallvariantstoexcel/sample1.per-base.bed.gz", checkIfExists: true)
                ]
                input[3] = 31
                input[4] = 'GRCh38/hg38'
                input[5] = 'vardict'
                input[6] = 'SeqCap'
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                {
                    def (workbookMeta, workbookFiles) = process.out.excels[0]
                    def (reportMeta, reportFiles) = process.out.reports[0]
                    def metaSnap = [
                        workbookMeta: workbookMeta,
                        reportMeta: reportMeta,
                        workbooks: workbookFiles.collect { workbookPath ->
                            def workbookFile = file(workbookPath)
                            [
                                path: "${workbookFile.parentFile.name}/${workbookFile.name}",
                                size: workbookFile.size().toInteger()
                            ]
                        }.sort { workbook -> workbook.path },
                        reports: reportFiles.collect { reportPath ->
                            def reportFile = file(reportPath)
                            [
                                path: "${reportFile.parentFile.name}/${reportFile.name}",
                                size: reportFile.size().toInteger()
                            ]
                        }.sort { report -> report.path }
                    ]
                    assert snapshot(metaSnap).match()
                }
            )
        }
    }

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'test_run' ],
                    file("${moduleTestDir}/samplesheet.csv", checkIfExists: true)
                ]
                input[1] = file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/smallvariantstoexcel/api_data.json", checkIfExists: true)
                input[2] = [
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/smallvariantstoexcel/Panel_v1.bed", checkIfExists: true),
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/smallvariantstoexcel/Design_v1.bed", checkIfExists: true),
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/smallvariantstoexcel/Panel_v1", checkIfExists: true),
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/smallvariantstoexcel/Design_v1", checkIfExists: true),
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/smallvariantstoexcel/Design_v1_all_genes_vs_transcripts", checkIfExists: true),
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/smallvariantstoexcel/sample1.vardict.vcf.gz", checkIfExists: true),
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/smallvariantstoexcel/sample1.per-base.bed.gz", checkIfExists: true)
                ]
                input[3] = 31
                input[4] = 'GRCh38/hg38'
                input[5] = 'vardict'
                input[6] = 'SeqCap'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}