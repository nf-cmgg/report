nextflow_process {

    name "Test Process EXOMECNV_TO_CSV"
    script "../main.nf"
    process "EXOMECNV_TO_CSV"

    tag "modules"
    tag "exomecnvtocsv"

    test("ExomeDepth CNVs output reporting [meta, samplesheet, input_files]") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'test_run' ],
                    file("${moduleTestDir}/samplesheet_exomecnv_to_csv.csv", checkIfExists: true)
                ]
                input[1] = [
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/exomecnvtocsv/FamCanc_v3", checkIfExists: true),
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/exomecnvtocsv/Pancreas_cancer_v4", checkIfExists: true),
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/exomecnvtocsv/Colon_cancer_v3", checkIfExists: true),
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/exomecnvtocsv/sample1.cnvs.vep.vcf.gz", checkIfExists: true),
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/exomecnvtocsv/sample2.cnvs.vep.vcf.gz", checkIfExists: true),
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/exomecnvtocsv/_CMGG_HyperCap_cnvs.FamCanc_v3", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                {
                    def (meta, summaryFiles) = process.out.summaries[0]
                    def metaSnap = [
                        meta: meta,
                        summaries: summaryFiles.collect { summaryPath ->
                            def summaryFile = file(summaryPath)
                            [name: summaryFile.name, content: summaryFile.text]
                        }.sort { summary -> summary.name }
                    ]
                    assert snapshot(metaSnap).match()
                }
            )
        }
    }

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'test_run' ],
                    file("${moduleTestDir}/samplesheet_exomecnv_to_csv.csv", checkIfExists: true)
                ]
                input[1] = [
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/exomecnvtocsv/FamCanc_v3", checkIfExists: true),
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/exomecnvtocsv/Pancreas_cancer_v4", checkIfExists: true),
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/exomecnvtocsv/Colon_cancer_v3", checkIfExists: true),
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/exomecnvtocsv/sample1.cnvs.vep.vcf.gz", checkIfExists: true),
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/exomecnvtocsv/sample2.cnvs.vep.vcf.gz", checkIfExists: true),
                    file("https://raw.githubusercontent.com/nf-cmgg/test-datasets/refs/heads/report/data/genomics/homo_sapiens/illumina/exomecnvtocsv/_CMGG_HyperCap_cnvs.FamCanc_v3", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
